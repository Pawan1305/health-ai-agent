PORT=5000
MONGODB_URI=mongodb://localhost:27017/medimind

# --- AI Provider Keys (add at least one) ---
# Google Gemini (free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (free models available): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Active AI Provider ---
# Set to 'gemini' or 'openrouter' to choose which provider handles all requests.
# Restart the backend after changing this value.
AI_PROVIDER=gemini

# --- OpenRouter Model (only used when AI_PROVIDER=openrouter) ---
# Free models: meta-llama/llama-3.3-70b-instruct:free | deepseek/deepseek-r1:free
#              google/gemma-3-27b-it:free | mistralai/mistral-7b-instruct:free | qwen/qwen-2.5-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

CLIENT_URL=http://localhost:5173
NODE_ENV=development
