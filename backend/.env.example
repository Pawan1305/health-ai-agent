PORT=5000
MONGODB_URI=mongodb://localhost:27017/medimind

# --- AI Keys (at least one required) ---
# AI Engine B key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AI Engine A key (optional but recommended): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional override for Gemini model (example fallback-safe value)
GEMINI_MODEL=gemini-1.5-flash-latest

# Optional: expose engine error details in user-facing chat fallback
SHOW_ENGINE_DIAGNOSTICS=false

CLIENT_URL=http://localhost:5173
NODE_ENV=development
